{
  "name": "labsoul-desktop",
  "productName": "labsoul",
  "version": "1.0.95",
  "private": true,
  "description": "labsoul — десктопная оболочка плеера",
  "main": "main.cjs",
  "author": "labsoul",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.labsoul.player",
    "productName": "labsoul",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "oauth.cjs",
      "discord.cjs",
      "overlay.cjs",
      "banner.html",
      "banner-preload.cjs",
      "package.json",
      "build/icon.png",
      "node_modules/ffmpeg-static/**",
      "miniplayer.html",
      "miniplayer-preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*.mjs",
          "package.json",
          "node_modules/**"
        ]
      },
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "labsoul-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "labsoul",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "labsoul-${version}-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "avaneqqqqqq",
      "repo": "Labsoul.Player",
      "releaseType": "release"
    },
    "afterPack": "build/afterpack.cjs",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "resedit": "^3.1.0"
  }
}
